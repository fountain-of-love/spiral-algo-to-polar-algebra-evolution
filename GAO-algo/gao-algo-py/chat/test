        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-built_in">min</span></span><span>(filt, key=</span><span><span class="hljs-keyword">lambda</span></span><span> j: (params.w_theta*ang_diff(theta[j], alpha) +
                                        params.w_r*</span><span><span class="hljs-built_in">abs</span></span><span>(r[j]-r[current])/</span><span><span class="hljs-built_in">max</span></span><span>(</span><span><span class="hljs-number">1e-9</span></span><span>, r_med)))
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>

</span><span><span class="hljs-comment"># ... when you have `candidates` (from a bin or fallback):</span></span><span>
tau = tau0
cand = </span><span><span class="hljs-literal">None</span></span><span>
</span><span><span class="hljs-keyword">for</span></span><span> _ </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-built_in">range</span></span><span>(max_tries):
    cand = pick_with_radial_band(candidates, alpha, current, tau)
    </span><span><span class="hljs-keyword">if</span></span><span> cand </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> </span><span><span class="hljs-literal">None</span></span><span>: </span><span><span class="hljs-keyword">break</span></span><span>
    tau *= grow
</span><span><span class="hljs-comment"># if still None, fall back to the original min over candidates</span></span><span>
</span><span><span class="hljs-keyword">if</span></span><span> cand </span><span><span class="hljs-keyword">is</span></span><span> </span><span><span class="hljs-literal">None</span></span><span> </span><span><span class="hljs-keyword">and</span></span><span> candidates:
    cand = </span><span><span class="hljs-built_in">min</span></span><span>(candidates, key=</span><span><span class="hljs-keyword">lambda</span></span><span> j: (params.w_theta*ang_diff(theta[j], alpha) +
                                          params.w_r*</span><span><span class="hljs-built_in">abs</span></span><span>(r[j]-r[current])/</span><span><span class="hljs-built_in">max</span></span><span>(</span><span><span class="hljs-number">1e-9</span></span><span>, r_med)))
</span></span></code></div></div></pre>
