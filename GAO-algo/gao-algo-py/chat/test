</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">gao_coherence_scores</span></span><span>(</span><span><span class="hljs-params">points, tour, r, theta, verbose=<span class="hljs-literal">True</span></span></span><span>):
    <span class="hljs-string">"""
    Compute quantitative coherence metrics for GAO Spiral geometry.
    Returns a dict of normalized scores (0–1 range, higher = better).
    """</span>

    n = </span><span><span class="hljs-built_in">len</span></span><span>(points)
    r = np.array(r)
