nn_scale = np.median([np.linalg.norm(np.asarray(pts[i]) - np.asarray(pts[(i+</span><span><span class="hljs-number">1</span></span><span>) % n]))
                      </span><span><span class="hljs-keyword">for</span></span><span> i </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-built_in">range</span></span><span>(</span><span><span class="hljs-built_in">min</span></span><span>(n, </span><span><span class="hljs-number">256</span></span><span>))])  </span><span><span class="hljs-comment"># cheap proxy</span></span><span>

tau0 = </span><span><span class="hljs-number">0.25</span></span><span> * nn_scale          </span><span><span class="hljs-comment"># initial band</span></span><span>
grow = </span><span><span class="hljs-number">1.7</span></span><span>                       </span><span><span class="hljs-comment"># widening factor per retry</span></span><span>
max_tries = </span><span><span class="hljs-number">3</span></span><span>

</span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">pick_with_radial_band</span></span><span>(</span><span><span class="hljs-params">cands, alpha, current, tau</span></span><span>):
    </span><span><span class="hljs-comment"># First pass: filter by |Δr| ≤ tau</span></span><span>
    filt = [j </span><span><span class="hljs-keyword">for</span></span><span> j </span><span><span class="hljs-keyword">in</span></span><span> cands </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-built_in">abs</span></span><span>(r[j] - r[current]) &lt;= tau]
