        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-built_in">min</span></span><span>(d, </span><span><span class="hljs-number">2</span></span><span> * math.pi - d)

    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">local_density_signal</span></span><span>(</span><span><span class="hljs-params">bθ_center: <span class="hljs-built_in">int</span></span></span><span>, br_center: </span><span><span class="hljs-built_in">int</span></span><span>) -&gt; </span><span><span class="hljs-built_in">float</span></span><span>:
        <span class="hljs-string">"""
