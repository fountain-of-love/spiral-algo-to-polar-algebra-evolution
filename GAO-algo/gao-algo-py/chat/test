        bins[bθ][br].append(i)

    visited = [</span><span><span class="hljs-literal">False</span></span><span>] * n
    current = </span><span><span class="hljs-built_in">min</span></span><span>(</span><span><span class="hljs-built_in">range</span></span><span>(n), key=</span><span><span class="hljs-keyword">lambda</span></span><span> i: r[i])  </span><span><span class="hljs-comment"># start near center</span></span><span>
    tour: </span><span><span class="hljs-type">List</span></span><span>[</span><span><span class="hljs-built_in">int</span></span><span>] = []

    </span><span><span class="hljs-comment"># --- Golden-angle baseline &amp; feedback state (Ecologia) ---</span></span><span>
    phi0 = math.tau * (</span><span><span class="hljs-number">1</span></span><span> - </span><span><span class="hljs-number">1</span></span><span> / ((</span><span><span class="hljs-number">1</span></span><span> + </span><span><span class="hljs-number">5</span></span><span> ** </span><span><span class="hljs-number">0.5</span></span><span>) / </span><span><span class="hljs-number">2</span></span><span>))  </span><span><span class="hljs-comment"># ≈ 137.50776°</span></span><span>
