    hist, _ = np.histogram(theta, bins=B)

    </span><span><span class="hljs-comment"># --- Dualitas: coupling of radius &amp; angle (correlation stability) ---</span></span><span>
    corr = np.corrcoef(r_t[:-</span><span><span class="hljs-number">1</span></span><span>], np.degrees(theta_t[:-</span><span><span class="hljs-number">1</span></span><span>]) % </span><span><span class="hljs-number">360</span></span><span>)[</span><span><span class="hljs-number">0</span></span><span>,</span><span><span class="hljs-number">1</span></span><span>]
