></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.2083em;"><span></span></span></span></span></span></span><span class="mclose">)</span></span></span></span> and <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>j</mi></msub><mo separator="true">,</mo><msub><mi>v</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(v_j,v_{j+1})</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1.0361em; vertical-align: -0.2861em;"></span><span class="mopen">(</span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3117em;"><span style="top: -2.55em; margin-left: -0.0359em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight" style="margin-right: 0.05724em;">j</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.2861em;"><span></span></span></span></span></span></span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3117em;"><span style="top: -2.55em; margin-left: -0.0359em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mathnormal mtight" style="margin-right: 0.05724em;">j</span><span class="mbin mtight">+</span><span class="mord mtight">1</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.2861em;"><span></span></span></span></span></span></span><span class="mclose">)</span></span></span></span> (indices mod <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>n</mi></mrow><annotation encoding="application/x-tex">n</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.4306em;"></span><span class="mord mathnormal">n</span></span></span></span>) whose line segments have a proper intersection (standard segment-intersection test).<br data-start="10016" data-end="10019">
<strong data-start="10019" data-end="10029">2-opt:</strong> classical best-improvement loop until no improving swap exists (or a fixed budget). <span class="" data-state="closed"><span class="ms-1 inline-flex max-w-full items-center relative top-[-0.094rem] animate-[show_150ms_ease-in]" data-testid="webpage-citation-pill"><a href="https://www.roeglin.org/publications/SODA07.pdf?utm_source=chatgpt.com" target="_blank" rel="noopener" alt="https://www.roeglin.org/publications/SODA07.pdf?utm_source=chatgpt.com" class="flex h-4.5 overflow-hidden rounded-xl px-2 text-[9px] font-medium transition-colors duration-150 ease-in-out text-token-text-secondary! bg-[#F4F4F4]! dark:bg-[#303030]!"><span class="relative start-0 bottom-0 flex h-full w-full items-center"><span class="flex h-4 w-full items-center justify-between overflow-hidden" style="opacity: 1; transform: none;"><span class="max-w-[15ch] grow truncate overflow-hidden text-center">roeglin.org</span></span></span></a></span></span></p>
<h3 data-start="10153" data-end="10169">8.4 Protocol</h3>
<ul data-start="10170" data-end="10364">
<li data-start="10170" data-end="10231">
<p data-start="10172" data-end="10231">20 random seeds per dataset/size; report means ± 95% CIs.</p>
</li>
<li data-start="10232" data-end="10295">
<p data-start="10234" data-end="10295">Fix identical 2-opt implementation &amp; budget across methods.</p>
</li>
<li data-start="10296" data-end="10364">
<p data-start="10298" data-end="10364">Provide code + seed list + CSV outputs to allow exact replication.</p>
</li>
</ul>
<h3 data-start="10366" data-end="10416">8.5 What we expect to confirm (the hypotheses)</h3>
<ul data-start="10417" data-end="10704">
<li data-start="10417" data-end="10495">
<p data-start="10419" data-end="10495"><strong data-start="10419" data-end="10426">H1:</strong> GAO’s initial crossing count <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mo>≪</mo></mrow><annotation encoding="application/x-tex">\ll</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.5782em; vertical-align: -0.0391em;"></span><span class="mrel">≪</span></span></span></span> NN and Sweep across datasets.</p>
</li>
<li data-start="10496" data-end="10567">
<p data-start="10498" data-end="10567"><strong data-start="10498" data-end="10505">H3:</strong> GAO requires fewer 2-opt improvements (faster convergence).</p>
</li>
<li data-start="10568" data-end="10704">
<p data-start="10570" data-end="10704"><strong data-start="10570" data-end="10582">Quality:</strong> GAO’s final 2-opt length within NN/CI ± few percent, sometimes better on clustered sets due to balanced angular coverage.</p>
