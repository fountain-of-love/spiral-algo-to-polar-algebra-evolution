    </span><span><span class="hljs-comment"># EMAs for flow &amp; rhythm</span></span><span>
    ema_r = </span><span><span class="hljs-number">0.0</span></span><span>
    ema_dtheta = phi0
    ema_r_beta = </span><span><span class="hljs-number">0.85</span></span><span>      </span><span><span class="hljs-comment"># smoother EMA for |Δr|</span></span><span>
    ema_theta_beta = </span><span><span class="hljs-number">0.85</span></span><span>  </span><span><span class="hljs-comment"># smoother EMA for Δθ</span></span><span>

    </span><span><span class="hljs-comment"># Radial scale for normalization (Adaptatio)</span></span><span>
    nn_scale = np.median([np.linalg.norm(np.asarray(pts[i]) - np.asarray(pts[j]))
                          </span><span><span class="hljs-keyword">for</span></span><span> i </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-built_in">range</span></span><span>(</span><span><span class="hljs-built_in">min</span></span><span>(n, </span><span><span class="hljs-number">50</span></span><span>)) </span><span><span class="hljs-keyword">for</span></span><span> j </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-built_in">range</span></span><span>(i + </span><span><span class="hljs-number">1</span></span><span>, </span><span><span class="hljs-built_in">min</span></span><span>(n, </span><span><span class="hljs-number">50</span></span><span>))]) </span><span><span class="hljs-keyword">or</span></span><span> </span><span><span class="hljs-number">1.0</span></span><span>
    r_med = </span><span><span class="hljs-built_in">float</span></span><span>(np.median(r)) </span><span><span class="hljs-keyword">or</span></span><span> </span><span><span class="hljs-number">1.0</span></span><span>

    </span><span><span class="hljs-comment"># Band filter (as in v2.1)</span></span><span>
