    </span><span><span class="hljs-keyword">def</span></span><span> </span><span><span class="hljs-title function_">choose_candidate</span></span><span>(</span><span><span class="hljs-params">alpha, current, last_sign, prev_dr</span></span><span>):
        </span><span><span class="hljs-string">"""Pick next point using θ×r neighborhood + Adaptatio refinements."""</span></span><span>
