<ul data-start="4434" data-end="4512">
<li data-start="4434" data-end="4458">
<p data-start="4436" data-end="4458">Adaptatio: <strong data-start="4447" data-end="4458">0.7–0.8</strong></p>
</li>
<li data-start="4459" data-end="4482">
<p data-start="4461" data-end="4482">Ecologia: <strong data-start="4471" data-end="4482">0.3–0.4</strong></p>
</li>
<li data-start="4483" data-end="4512">
<p data-start="4485" data-end="4512">Overall coherence: <strong data-start="4504" data-end="4512">~0.7</strong></p>
</li>
</ul>
