    </span><span><span class="hljs-comment"># Feedback gains (safe defaults)</span></span><span>
    k_r = </span><span><span class="hljs-number">0.35</span></span><span>       </span><span><span class="hljs-comment"># coupling from |Δr| to phase</span></span><span>
    k_den = </span><span><span class="hljs-number">0.20</span></span><span>     </span><span><span class="hljs-comment"># coupling from local density to phase</span></span><span>
